# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Clerk Redirect URLs (optional, for development)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Database
DATABASE_URL=your_database_url_here

# Third-party Services
OPENAI_API_KEY=your_openai_api_key_here
TELEPHONY_SERVICE_TOKEN=generate_one_long_random_shared_secret
NEXT_PUBLIC_VOICE_ASSISTANT_PHONE=+18557995436

# Voice runtime state (DynamoDB is automatic on Vercel; set explicitly to make intent clear)
VOICE_CONVERSATION_STORE=dynamodb
VOICE_CONVERSATION_TABLE=lll-shadow-campaigns
AWS_REGION=us-east-1

# Long-lived Render worker used for live Odysseus searches
ODYSSEUS_WORKER_URL=https://your-odysseus-worker.onrender.com
ODYSSEUS_WORKER_TOKEN=generate_a_different_long_random_shared_secret
CB_EMAIL=your_cb_agent_tools_email
CB_PASSWORD=your_cb_agent_tools_password
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
PUSHOVER_API_TOKEN=your_pushover_application_token_here
PUSHOVER_RECIPIENT_KEY=your_pushover_user_or_group_key_here

# Other Services
PEXELS_API_KEY=your_pexels_api_key_here
